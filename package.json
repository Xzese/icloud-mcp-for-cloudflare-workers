{
  "name": "icloud-reminders-mcp-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/setup/install-ci.mjs",
    "dev": "node scripts/build/run-framework.mjs dev",
    "dev:icloud": "node scripts/dev/run-local-icloud.mjs",
    "session:retention:local": "node scripts/dev/migrate-local-session-retention.mjs",
    "session:local:centralize": "node scripts/dev/centralize-local-icloud.mjs",
    "build": "node scripts/build/run-framework.mjs build",
    "start": "node --import ./scripts/lib/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "node tests/integration/worker.mjs",
    "test:drive:large": "node tests/integration/drive-large.mjs",
    "test:local": "node tests/integration/local-icloud.mjs",
    "test:icloud-write": "node scripts/dev/validate-local-reminder-writes.mjs",
    "evidence:reminder": "node scripts/dev/capture-reminder-evidence.mjs",
    "fixtures:generate": "python3 tests/fixtures/generate.py",
    "verify:artifact": "node scripts/build/verify-artifact.mjs",
    "notices:generate": "node scripts/release/generate-notices.mjs",
    "build:cloudflare": "REMINDERS_DEPLOYMENT=cloudflare npm run build",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/deploy/generate-cloudflare-config.mjs && wrangler deploy --config wrangler.generated.toml",
    "sites:prepare": "node scripts/deploy/prepare-sites-source.mjs",
    "build:check": "npm run build:cloudflare && node scripts/deploy/generate-cloudflare-config.mjs --check && wrangler deploy --dry-run --config wrangler.generated.toml --outdir .wrangler/dry-run && npm run test:cloudflare",
    "public-config:check": "node scripts/release/check-public-config.mjs",
    "release:prepare": "node scripts/release/prepare-public-release.mjs",
    "test:cloudflare": "node tests/integration/cloudflare-worker.mjs",
    "db:setup:local": "node --import ./scripts/lib/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 execute DB --local --config dist/server/wrangler.json --persist-to .wrangler/state --file schema.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^6.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "input-otp": "^1.5.0",
    "jose": "6.2.13",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint-plugin-react": "7.37.5",
    "json-rpc-2.0": "1.8.1",
    "miniflare": "4.20260730.0",
    "oxlint": "1.90.0",
    "raw-body": "4.0.0",
    "react-server-dom-webpack": "19.3.1",
    "smol-toml": "1.9.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "undici": "8.12.3",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0",
    "ws": "8.22.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp@<0.35.5": "^0.35.5",
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
  },
  "description": "iCloud Reminders MCP server with read and reminder mutation tools for Cloudflare Workers and ChatGPT Sites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xzese/icloud-reminders-mcp-for-cloudflare-workers.git"
  },
  "bugs": {
    "url": "https://github.com/Xzese/icloud-reminders-mcp-for-cloudflare-workers/issues"
  },
  "homepage": "https://github.com/Xzese/icloud-reminders-mcp-for-cloudflare-workers#readme"
}
