REMINDERS_OWNER_ID=
APP_ORIGIN=
# Sites only: existing service-access credential, configured as a runtime secret.
# Allows a transfer client through Sites' privacy gate; grants no owner identity.
DRIVE_TRANSFER_SITES_GATEWAY_TOKEN=
ENCRYPTION_KEY_ID=
ENCRYPTION_KEYS_JSON=
# Operator acknowledgements. Empty values keep Apple login disabled.
LIVE_APPLE_CONNECTION_APPROVED=
APPLE_CRYPTO_REVIEW_APPROVED=
# Empty on Sites. Standalone Queue delivery requires verified private bindings.
REMINDER_JOB_EXECUTION_MODE=
REMINDER_JOB_QUEUE_NAME=

# Large Drive uploads default to verified TLS sockets on Cloudflare Workers/Sites.
# Set fetch only when the runtime HTTP egress accepts the complete file size.
# DRIVE_UPLOAD_TRANSPORT=fetch
